---
// src/layouts/BaseLayout.astro
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  structuredData?: object;
  ogImage?: string;
  twitterImage?: string;
}

const {
  title = "IVESTAUTO - Especialistas en 4x4 y Vehículos de Ocasión",
  description = "IVESTAUTO - Especialistas en venta de accesorios y recambios para vehículos 4x4. Compra-venta de vehículos de ocasión y camiones. Calidad y experiencia garantizada.",
  canonicalUrl,
  noindex = false,
  structuredData,
  ogImage = "/og-image.jpg",
  twitterImage = ogImage
} = Astro.props;

const ORIGIN = Astro.site ?? Astro.url.origin;
const currentUrl = canonicalUrl ? new URL(canonicalUrl, ORIGIN).href : Astro.url.href;
const fullTitle = title.includes("IVESTAUTO") ? title : `${title} | IVESTAUTO`;
const ogImageUrl = new URL(ogImage, ORIGIN).href;
const twitterImageUrl = new URL(twitterImage, ORIGIN).href;

const org = {
  "@context": "https://schema.org",
  "@type": "AutoPartsStore",
  "name": "IVESTAUTO",
  "description": description,
  "url": ORIGIN,
  "logo": `${ORIGIN}/logo.png`,
  "telephone": "+34-682-290-381",
  "email": "info@ivestauto.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Calle Ejemplo, 123",
    "addressLocality": "Madrid",
    "postalCode": "28001",
    "addressCountry": "ES"
  },
  "openingHours": [
    "Mo-Fr 09:00-18:00",
    "Sa 09:00-14:00"
  ],
  "sameAs": [
    "https://www.facebook.com/ivestauto",
    "https://www.instagram.com/ivestauto",
    "https://www.linkedin.com/company/ivestauto"
  ]
};
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="4x4, accesorios 4x4, recambios, vehículos ocasión, camiones, todoterreno, repuestos, automóvil" />
    <meta name="author" content="IVESTAUTO" />

    <link rel="canonical" href={currentUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="IVESTAUTO" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={currentUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={twitterImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <meta name="generator" content="Astro" />
    <slot name="head" />
  </head>

  <body class="font-sans antialiased bg-white text-gray-900">
    <div class="flex flex-col min-h-screen">
      <!-- Skip link - usa clases de Tailwind -->
      <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-red-600 text-white px-4 py-2 rounded-lg z-50"
      >
        Saltar al contenido principal
      </a>

      <header>
        <slot name="header" />
      </header>

      <main id="main-content" class="flex-grow">
        <slot />
      </main>

      <footer>
        <slot name="footer" />
      </footer>
    </div>

    <script type="application/ld+json" is:inline>
      {JSON.stringify(org)}
    </script>

    {structuredData && (
      <script type="application/ld+json" is:inline>
        {JSON.stringify(structuredData)}
      </script>
    )}
  </body>
</html>