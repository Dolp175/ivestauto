---
// src/pages/index.astro
// Importaciones de componentes (si los tuvieras)
// import Header from '../components/Header.astro';
// import Footer from '../components/Footer.astro';
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="IVESTAUTO - Especialistas en accesorios y recambios para vehículos 4x4, compra-venta de vehículos de ocasión y camiones.">
    <meta name="keywords" content="4x4, accesorios, recambios, vehículos ocasión, camiones, off-road">
    <meta name="author" content="IVESTAUTO">
    <title>IVESTAUTO - Accesorios y Recambios 4x4</title>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://ivestauto.com/">
    <meta property="og:title" content="IVESTAUTO - Especialistas en 4x4">
    <meta property="og:description" content="Accesorios, recambios y vehículos 4x4 de ocasión">
    <meta property="og:image" content="https://ivestauto.com/images/og-image.jpg">
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://ivestauto.com/">
    <meta property="twitter:title" content="IVESTAUTO - Especialistas en 4x4">
    <meta property="twitter:description" content="Accesorios, recambios y vehículos 4x4 de ocasión">
    <meta property="twitter:image" content="https://ivestauto.com/images/twitter-image.jpg">
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Styles -->
    <style>
      body {
        font-family: 'Montserrat', sans-serif;
      }
    </style>
  </head>

  <body class="bg-white text-gray-800">
     <!-- Header/Navigation -->
    <header class="bg-white shadow-lg sticky top-0 z-50">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Logo -->
                <div class="flex-shrink-0">
                    <h1 class="text-2xl font-bold">
                        <span class="text-black">IVEST</span><span class="text-red-700">AUTO</span>
                    </h1>
                </div>
                
                <!-- Navigation Desktop -->
                <div class="hidden md:block">
                    <div class="ml-10 flex items-baseline space-x-8">
                        <a href="#inicio" class="text-gray-900 hover:text-red-700 px-3 py-2 text-sm font-medium transition-colors">Inicio</a>
                        <a href="#servicios" class="text-gray-900 hover:text-red-700 px-3 py-2 text-sm font-medium transition-colors">Servicios</a>
                        <a href="#productos" class="text-gray-900 hover:text-red-700 px-3 py-2 text-sm font-medium transition-colors">Productos</a>
                        <a href="#vehiculos" class="text-gray-900 hover:text-red-700 px-3 py-2 text-sm font-medium transition-colors">Vehículos</a>
                        <a href="#contacto" class="bg-red-700 text-white hover:bg-red-800 px-4 py-2 rounded-md text-sm font-medium transition-colors">Contacto</a>
                    </div>
                </div>
                
                <!-- Mobile menu button -->
                <div class="md:hidden">
                    <button type="button" id="mobile-menu-button" class="inline-flex items-center justify-center p-2 rounded-md text-gray-900 hover:text-red-700 focus:outline-none">
                        <span class="sr-only">Abrir menú principal</span>
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>
                </div>
            </div>
            
            <!-- Mobile Navigation -->
            <div id="mobile-menu" class="mobile-menu hidden md:hidden">
                <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3 bg-white border-t">
                    <a href="#inicio" class="text-gray-900 hover:text-red-700 block px-3 py-2 text-base font-medium">Inicio</a>
                    <a href="#servicios" class="text-gray-900 hover:text-red-700 block px-3 py-2 text-base font-medium">Servicios</a>
                    <a href="#productos" class="text-gray-900 hover:text-red-700 block px-3 py-2 text-base font-medium">Productos</a>
                    <a href="#vehiculos" class="text-gray-900 hover:text-red-700 block px-3 py-2 text-base font-medium">Vehículos</a>
                    <a href="#contacto" class="text-gray-900 hover:text-red-700 block px-3 py-2 text-base font-medium">Contacto</a>
                </div>
            </div>
        </nav>
    </header>

<!-- Hero Section -->
<section id="inicio" class="relative bg-gray-900 text-white">
  <div class="absolute inset-0 overflow-hidden">
    <!-- Imagen para móvil (enfoque en la parte inferior) -->
    <div class="block md:hidden h-full">
      <img src="https://images.unsplash.com/photo-1535732820275-9ffd998cac22?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&h=1000&q=80" 
           alt="Vehículo 4x4 en terreno off-road" 
           class="w-full h-full object-cover object-[center_70%]">
    </div>
    
    <!-- Imagen para desktop (enfoque más amplio) -->
    <div class="hidden md:block h-full">
      <img src="https://images.unsplash.com/photo-1535732820275-9ffd998cac22?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1770&q=80" 
           alt="Vehículo 4x4 en terreno off-road" 
           class="w-full h-full object-cover object-[center_40%]">
    </div>
    
    <!-- Overlay para mejorar legibilidad -->
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
  </div>
  
  <!-- Contenido del hero - Ajustado para móviles -->
  <div class="container mx-auto px-4 relative z-10">
    <div class="min-h-[70vh] md:min-h-[80vh] flex items-center pt-16 pb-10 md:py-0">
      <div class="max-w-2xl">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">Todo para tu <span class="text-red-600">4x4</span> en un solo lugar</h1>
        <p class="text-lg md:text-xl mb-8">Accesorios, recambios y vehículos de ocasión. Encuentra todo lo que necesitas para tu aventura.</p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#productos" class="bg-red-700 hover:bg-red-800 text-white font-semibold py-3 px-6 rounded-lg transition-colors text-center">
            Ver productos
          </a>
          <a href="#contacto" class="bg-transparent hover:bg-red-700 text-white font-semibold py-3 px-6 rounded-lg border border-white hover:border-red-700 transition-colors text-center">
            Contactar
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Services Section -->
<section id="servicios" class="py-16 bg-gray-50">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Nuestros <span class="text-red-700">Servicios</span></h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">Ofrecemos soluciones completas para amantes de los vehículos 4x4 y profesionales del transporte</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Service 1 -->
      <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden group border border-gray-100 relative">
        <div class="absolute top-0 left-0 w-full h-1 bg-red-700"></div>
        <div class="p-8">
          <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mb-6 group-hover:bg-red-200 transition-colors duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-red-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-4 text-gray-800 group-hover:text-red-700 transition-colors duration-300">Accesorios 4x4</h3>
          <p class="text-gray-600 leading-relaxed">Todo tipo de accesorios para personalizar y preparar tu vehículo para cualquier terreno y aventura.</p>
        </div>
        <div class="px-8 pb-6">
          <a href="#" class="text-red-700 font-medium flex items-center group-hover:translate-x-1 transition-transform duration-300">
            Descubrir más
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
      
      <!-- Service 2 -->
      <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden group border border-gray-100 relative">
        <div class="absolute top-0 left-0 w-full h-1 bg-red-700"></div>
        <div class="p-8">
          <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mb-6 group-hover:bg-red-200 transition-colors duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-red-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-4 text-gray-800 group-hover:text-red-700 transition-colors duration-300">Recambios y Repuestos</h3>
          <p class="text-gray-600 leading-relaxed">Amplio stock de recambios originales y alternativos para mantener tu vehículo en perfecto estado.</p>
        </div>
        <div class="px-8 pb-6">
          <a href="#" class="text-red-700 font-medium flex items-center group-hover:translate-x-1 transition-transform duration-300">
            Descubrir más
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
      
      <!-- Service 3 -->
      <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden group border border-gray-100 relative">
        <div class="absolute top-0 left-0 w-full h-1 bg-red-700"></div>
        <div class="p-8">
          <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mb-6 group-hover:bg-red-200 transition-colors duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-red-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-4 text-gray-800 group-hover:text-red-700 transition-colors duration-300">Compra-Venta de Vehículos</h3>
          <p class="text-gray-600 leading-relaxed">Compramos y vendemos vehículos 4x4 de ocasión y camiones, con todas las garantías.</p>
        </div>
        <div class="px-8 pb-6">
          <a href="#" class="text-red-700 font-medium flex items-center group-hover:translate-x-1 transition-transform duration-300">
            Descubrir más
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

  <!-- Featured Products -->
<section id="productos" class="py-16 bg-gray-50">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Productos <span class="text-red-700">Destacados</span></h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">Los accesorios y recambios más demandados por nuestros clientes</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Product 1 -->
      <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300 group border border-gray-100">
        <div class="h-48 bg-gray-100 overflow-hidden">
          <img src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" 
               alt="Neumáticos 4x4" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
        </div>
        <div class="p-6">
          <h3 class="text-xl font-semibold mb-3 text-gray-800 group-hover:text-red-700 transition-colors duration-300">Neumáticos Off-Road</h3>
          <p class="text-gray-600 mb-6 leading-relaxed">Neumáticos todo terreno para las condiciones más extremas.</p>
          <div class="text-center">
            <button class="bg-red-700 hover:bg-red-800 text-white font-medium py-2 px-6 rounded-lg transition-colors duration-300">
              Más información
            </button>
          </div>
        </div>
      </div>
      
      <!-- Product 2 -->
      <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300 group border border-gray-100">
        <div class="h-48 bg-gray-100 overflow-hidden">
          <img src="https://images.unsplash.com/photo-1494905998402-395d579af36f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" 
               alt="Suspensión elevada" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
        </div>
        <div class="p-6">
          <h3 class="text-xl font-semibold mb-3 text-gray-800 group-hover:text-red-700 transition-colors duration-300">Suspensiones Elevadas</h3>
          <p class="text-gray-600 mb-6 leading-relaxed">Kits de suspensión para ganar altura y capacidad off-road.</p>
          <div class="text-center">
            <button class="bg-red-700 hover:bg-red-800 text-white font-medium py-2 px-6 rounded-lg transition-colors duration-300">
              Más información
            </button>
          </div>
        </div>
      </div>
      
      <!-- Product 3 -->
      <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300 group border border-gray-100">
        <div class="h-48 bg-gray-100 overflow-hidden">
          <img src="https://images.unsplash.com/photo-1553440569-bcc63803a83d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=775&q=80" 
               alt="Barras de techo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
        </div>
        <div class="p-6">
          <h3 class="text-xl font-semibold mb-3 text-gray-800 group-hover:text-red-700 transition-colors duration-300">Barras de Techo</h3>
          <p class="text-gray-600 mb-6 leading-relaxed">Sistemas de transporte para equipamiento y mercancías.</p>
          <div class="text-center">
            <button class="bg-red-700 hover:bg-red-800 text-white font-medium py-2 px-6 rounded-lg transition-colors duration-300">
              Más información
            </button>
          </div>
        </div>
      </div>
      
      <!-- Product 4 -->
      <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300 group border border-gray-100">
        <div class="h-48 bg-gray-100 overflow-hidden">
          <img src="https://images.unsplash.com/photo-1542362567-b07e54358753?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" 
               alt="Winches de recuperación" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
        </div>
        <div class="p-6">
          <h3 class="text-xl font-semibold mb-3 text-gray-800 group-hover:text-red-700 transition-colors duration-300">Winches</h3>
          <p class="text-gray-600 mb-6 leading-relaxed">Sistemas de recuperación para situaciones extremas.</p>
          <div class="text-center">
            <button class="bg-red-700 hover:bg-red-800 text-white font-medium py-2 px-6 rounded-lg transition-colors duration-300">
              Más información
            </button>
          </div>
        </div>
      </div>
    </div>
    
    <div class="text-center mt-12">
      <a href="#" class="inline-block bg-red-700 hover:bg-red-800 text-white font-semibold py-3 px-8 rounded-lg transition-colors duration-300">
        Ver todos los productos
      </a>
    </div>
  </div>
</section>

    <!-- Vehicles Section -->
    <section id="vehiculos" class="py-16 bg-gray-900 text-white">
      <div class="container mx-auto px-4">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Vehículos de <span class="text-red-500">Ocasion</span></h2>
          <p class="text-xl text-gray-300 max-w-3xl mx-auto">Descubre nuestra selección de vehículos 4x4 y camiones de ocasión</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Vehicle 1 -->
          <div class="bg-gray-800 rounded-lg overflow-hidden">
            <div class="h-56 bg-gray-700 overflow-hidden">
              <img src="https://images.unsplash.com/photo-1549399542-7e82138d0d71?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80" 
                   alt="Jeep Wrangler" class="w-full h-full object-cover">
            </div>
            <div class="p-6">
              <h3 class="text-xl font-semibold mb-2">Jeep Wrangler Rubicon</h3>
              <div class="flex items-center mb-4">
                <span class="text-red-500 font-bold text-lg mr-2">32.500€</span>
                <span class="text-gray-400 text-sm">2019 • 45.000 km</span>
              </div>
              <div class="flex flex-wrap gap-2 mb-4">
                <span class="bg-gray-700 text-gray-300 text-sm px-3 py-1 rounded-full">Diésel</span>
                <span class="bg-gray-700 text-gray-300 text-sm px-3 py-1 rounded-full">Automático</span>
                <span class="bg-gray-700 text-gray-300 text-sm px-3 py-1 rounded-full">4x4</span>
              </div>
              <button class="w-full bg-red-700 hover:bg-red-800 text-white py-2 px-4 rounded-lg transition-colors">
                Ver detalles
              </button>
            </div>
          </div>
          
          <!-- Vehicle 2 -->
          <div class="bg-gray-800 rounded-lg overflow-hidden">
            <div class="h-56 bg-gray-700 overflow-hidden">
              <img src="https://images.unsplash.com/photo-1600724597491-1c5726f15d5f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80" 
                   alt="Toyota Land Cruiser" class="w-full h-full object-cover">
            </div>
            <div class="p-6">
              <h3 class="text-xl font-semibold mb-2">Toyota Land Cruiser</h3>
              <div class="flex items-center mb-4">
                <span class="text-red-500 font-bold text-lg mr-2">38.900€</span>
                <span class="text-gray-400 text-sm">2020 • 32.000 km</span>
              </div>
              <div class="flex flex-wrap gap-2 mb-4">
                <span class="bg-gray-700 text-gray-300 text-sm px-3 py-1 rounded-full">Diésel</span>
                <span class="bg-gray-700 text-gray-300 text-sm px-3 py-1 rounded-full">Automático</span>
                <span class="bg-gray-700 text-gray-300 text-sm px-3 py-1 rounded-full">4x4</span>
              </div>
              <button class="w-full bg-red-700 hover:bg-red-800 text-white py-2 px-4 rounded-lg transition-colors">
                Ver detalles
              </button>
            </div>
          </div>
          
          <!-- Vehicle 3 -->
          <div class="bg-gray-800 rounded-lg overflow-hidden">
            <div class="h-56 bg-gray-700 overflow-hidden">
              <img src="https://images.unsplash.com/photo-1632882006957-5b6d08a391c9?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80" 
                   alt="Camión Volvo" class="w-full h-full object-cover">
            </div>
            <div class="p-6">
              <h3 class="text-xl font-semibold mb-2">Volvo FH 540</h3>
              <div class="flex items-center mb-4">
                <span class="text-red-500 font-bold text-lg mr-2">85.000€</span>
                <span class="text-gray-400 text-sm">2018 • 420.000 km</span>
              </div>
              <div class="flex flex-wrap gap-2 mb-4">
                <span class="bg-gray-700 text-gray-300 text-sm px-3 py-1 rounded-full">Diésel</span>
                <span class="bg-gray-700 text-gray-300 text-sm px-3 py-1 rounded-full">Automático</span>
                <span class="bg-gray-700 text-gray-300 text-sm px-3 py-1 rounded-full">6x4</span>
              </div>
              <button class="w-full bg-red-700 hover:bg-red-800 text-white py-2 px-4 rounded-lg transition-colors">
                Ver detalles
              </button>
            </div>
          </div>
        </div>
        
        <div class="text-center mt-12">
          <a href="#" class="inline-block bg-red-700 hover:bg-red-800 text-white font-semibold py-3 px-8 rounded-lg transition-colors">
            Ver todos los vehículos
