---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import RecambioCard from '../components/ui/RecambioCard.astro';
import ContactForm from '../components/ui/ContactForm.astro';
---

<BaseLayout>
  <Fragment slot="header">
    <Header />
  </Fragment>

  <main>
        <!-- Hero Section -->
    <section id="inicio" class="relative bg-gradient-to-b from-slate-500 to-slate-900 text-white">
        <div class="absolute inset-0 bg-black opacity-50"></div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
            <div class="text-center">
                <h2 class="text-4xl md:text-6xl font-bold mb-6">
                    Tu especialista en <span class="text-red-700">4x4</span>
                </h2>
                <p class="text-xl md:text-2xl text-gray-300 mb-8 max-w-3xl mx-auto">
                    Accesorios, recambios y vehículos de ocasión. Más de 10 años de experiencia en el sector automotriz.
                </p>
                <div class="space-y-4 sm:space-y-0 sm:space-x-4 sm:flex sm:justify-center">
                    <a href="#servicios" class="inline-block bg-red-700 text-white px-8 py-3 rounded-lg text-lg font-semibold hover:bg-red-800 transition-colors">
                        Nuestros Servicios
                    </a>
                    <a href="#contacto" class="inline-block border-2 border-white text-white px-8 py-3 rounded-lg text-lg font-semibold hover:bg-white hover:text-gray-900 transition-colors">
                        Contactar Ahora
                    </a>
                </div>
            </div>
        </div>
    </section>

        <!-- Servicios -->
    <section id="servicios" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
                    Nuestros <span class="text-red-700">Servicios</span>
                </h2>
                <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
                    Soluciones integrales para amantes de los todoterrenos. Calidad, experiencia y compromiso en cada servicio. Importación de todo tipo de vehiculos
                </p>
            </div>
            
            <div class="grid md:grid-cols-3 gap-8 lg:gap-12">
                <!-- Servicio 1 - Accesorios 4x4 -->
                <div class="group relative bg-gradient-to-br from-white to-gray-50 rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-300 border border-gray-100 hover:border-red-200">
                    <div class="absolute -top-4 left-8">
                        <div class="w-16 h-16 bg-gradient-to-br from-red-700 to-red-800 rounded-2xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"/>
                            </svg>
                        </div>
                    </div>
                    <div class="pt-12">
                        <h3 class="text-2xl font-bold text-gray-900 mb-4 group-hover:text-red-700 transition-colors">Accesorios 4x4</h3>
                        <p class="text-gray-600 leading-relaxed mb-6">
                            Barras de techo, winches, protecciones, iluminación LED y todo lo necesario para preparar tu vehículo para la aventura.
                        </p>
                        <ul class="space-y-2 text-sm text-gray-500">
                            <li class="flex items-center">
                                <svg class="w-4 h-4 text-red-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                </svg>
                                Barras y portaequipajes
                            </li>
                            <li class="flex items-center">
                                <svg class="w-4 h-4 text-red-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                </svg>
                                Sistemas de iluminación
                            </li>
                            <li class="flex items-center">
                                <svg class="w-4 h-4 text-red-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                </svg>
                                Protecciones y blindajes
                            </li>
                        </ul>
                    </div>
                </div>
                
                <!-- Servicio 2 - Recambios -->
                <div class="group relative bg-gradient-to-br from-white to-gray-50 rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-300 border border-gray-100 hover:border-red-200">
                    <div class="absolute -top-4 left-8">
                        <div class="w-16 h-16 bg-gradient-to-br from-red-800 to-slate-800 rounded-2xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            </svg>
                        </div>
                    </div>
                    <div class="pt-12">
                        <h3 class="text-2xl font-bold text-gray-900 mb-4 group-hover:text-red-700 transition-colors">Recambios 4x4</h3>
                        <p class="text-gray-600 leading-relaxed mb-6">
                            Piezas de calidad garantizada para mantener el rendimiento y seguridad de tu vehículo en óptimas condiciones.
                        </p>
                        <ul class="space-y-2 text-sm text-gray-500">
                            <li class="flex items-center">
                                <svg class="w-4 h-4 text-red-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                </svg>
                                Filtros y lubricantes
                            </li>
                            <li class="flex items-center">
                                <svg class="w-4 h-4 text-red-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                </svg>
                                Frenos y suspensión
                            </li>
                            <li class="flex items-center">
                                <svg class="w-4 h-4 text-red-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                </svg>
                                Motor y transmisión
                            </li>
                        </ul>
                    </div>
                </div>
                
                <!-- Servicio 3 - Compra-Venta -->
                <div class="group relative bg-gradient-to-br from-white to-gray-50 rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-300 border border-gray-100 hover:border-red-200">
                    <div class="absolute -top-4 left-8">
                        <div class="w-16 h-16 bg-gradient-to-br from-slate-700 to-slate-800 rounded-2xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 12h16"/>
                            </svg>
                        </div>
                    </div>
                    <div class="pt-12">
                        <h3 class="text-2xl font-bold text-gray-900 mb-4 group-hover:text-red-700 transition-colors">Vehiculos de Ocasión</h3>
                        <p class="text-gray-600 leading-relaxed mb-6">
                            Vehículos de alta gama y camiones de importación. Garantía de calidad y transparencia en cada operación.
                        </p>
                        <ul class="space-y-2 text-sm text-gray-500">
                            <li class="flex items-center">
                                <svg class="w-4 h-4 text-red-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                </svg>
                                Vehículos revisados y garantizados
                            </li>
                            <li class="flex items-center">
                                <svg class="w-4 h-4 text-red-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                </svg>
                                Financiación disponible
                            </li>
                            <li class="flex items-center">
                                <svg class="w-4 h-4 text-red-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                </svg>
                                Tasación profesional
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- CTA inferior -->
            <div class="text-center mt-16">
                <div class="bg-gradient-to-r from-red-800 to-slate-900 rounded-2xl p-8 lg:p-12 text-white shadow-2xl">
                    <h3 class="text-2xl lg:text-3xl font-bold mb-4">¿Necesitas asesoramiento profesional?</h3>
                    <p class="text-red-100 text-lg mb-6 max-w-2xl mx-auto">
                        Nuestro equipo de expertos está listo para ayudarte a encontrar la solución perfecta para tu vehículo.
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4 justify-center">
                        <a href="tel:+34682290381" class="bg-white text-red-700 px-8 py-4 rounded-lg font-bold hover:bg-gray-100 transition-colors shadow-lg">
                            <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                            </svg>
                            Llamar Ahora
                        </a>
                        <a href="#contacto" class="border-2 border-white text-white px-8 py-4 rounded-lg font-bold hover:bg-white hover:text-red-700 transition-colors">
                            Solicitar Información
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

<!-- Proceso de Compra de Vehículos - Colores Actualizados -->
<section id="vehiculos" class="py-20 bg-gradient-to-br from-slate-50 to-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-start">
            
            <!-- Columna izquierda - Texto introductorio -->
            <div class="md:sticky md:top-24">
                <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
                    Importamos tu vehículo perfecto, 
                    <span class="bg-clip-text text-transparent bg-gradient-to-r from-slate-700 to-red-600">
                        sin complicaciones
                    </span>
                </h2>
                
                <div class="prose text-gray-600 max-w-none">
                    <p class="text-lg mb-4 leading-relaxed">
                        Desde <strong class="text-slate-700">turismos hasta camiones</strong>, 
                        gestionamos todo el proceso de importación y entrega para que solo tengas que 
                        <strong>disfrutar de tu nuevo vehículo</strong>.
                    </p>

                    <p class="mb-6 leading-relaxed">
                        Nuestro servicio integral incluye:
                    </p>

                    <ul class="space-y-3 mb-6 pl-5">
                        <li class="flex items-start">
                            <svg class="w-6 h-6 text-red-600 mt-0.5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span><strong>Búsqueda internacional</strong> de las mejores oportunidades</span>
                        </li>
                        <li class="flex items-start">
                            <svg class="w-6 h-6 text-red-600 mt-0.5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span><strong>Inspección mecánica</strong> exhaustiva antes de la compra</span>
                        </li>
                        <li class="flex items-start">
                            <svg class="w-6 h-6 text-red-600 mt-0.5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span><strong>Tramitación completa</strong> de importación y documentación</span>
                        </li>
                    </ul>

                    <div class="p-6 bg-gradient-to-br from-slate-100 to-gray-200 rounded-xl border-l-4 border-red-600 mb-6">
                        <p class="text-slate-800 font-semibold mb-2 flex items-center">
                            <svg class="w-5 h-5 text-red-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                            </svg>
                            Importamos todo tipo de vehículos
                        </p>
                        <p class="text-slate-700 text-sm leading-relaxed">
                            Turismos de gama alta, vehículos comerciales, camiones, flotas completas 
                            para empresas y rent-a-car. Adaptamos nuestro servicio a tus necesidades específicas.
                        </p>
                    </div>

                    <p class="text-gray-700 leading-relaxed">
                        <strong>Sin desplazamientos, sin gestiones, sin preocupaciones.</strong> 
                        Te lo llevamos directamente a casa, listo para conducir.
                    </p>
                </div>
            </div>

            <!-- Columna derecha - Acordeón de pasos -->
            <div class="space-y-4">
                
                <!-- Paso 1: Requisitos - AZUL OSCURO -->
                <div x-data="{ open: true }" class="border-2 border-blue-700 rounded-xl overflow-hidden transition-all duration-200 hover:shadow-lg hover:border-blue-800">
                    <button @click="open = !open" class="flex justify-between items-center w-full p-6 text-left bg-gradient-to-br from-slate-800 to-blue-600 text-white">
                        <div class="flex items-center">
                            <div class="w-12 h-12 rounded-full bg-white flex items-center justify-center text-blue-800 font-bold mr-4 shadow-lg">
                                1
                            </div>
                            <h3 class="text-xl font-bold text-white">
                                Definición de Requisitos
                            </h3>
                        </div>
                        <svg class="w-6 h-6 text-white transform transition-transform duration-200" :class="{ 'rotate-180': open }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </button>
                    <div x-show="open" x-collapse class="px-6 pb-6 pt-2 bg-white">
                        <p class="text-gray-600 mb-4">Cuéntanos exactamente qué buscas y nos ponemos manos a la obra.</p>
                        <ul class="space-y-3 text-gray-600">
                            <li class="flex items-start">
                                <svg class="w-5 h-5 text-blue-700 mt-0.5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                                </svg>
                                <span>Marca, modelo y año preferido</span>
                            </li>
                            <li class="flex items-start">
                                <svg class="w-5 h-5 text-blue-700 mt-0.5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                                </svg>
                                <span>Presupuesto y condiciones de financiación</span>
                            </li>
                            <li class="flex items-start">
                                <svg class="w-5 h-5 text-blue-700 mt-0.5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                </svg>
                                <span>Tipo de vehículo: turismo, todoterreno, comercial, camión o flota</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Paso 2: Búsqueda - ROJO OSCURO -->
                <div x-data="{ open: false }" class="border-2 border-red-700 rounded-xl overflow-hidden transition-all duration-200 hover:shadow-lg hover:border-red-800">
                    <button @click="open = !open" class="flex justify-between items-center w-full p-6 text-left bg-gradient-to-br from-red-700 to-red-900 text-white">
                        <div class="flex items-center">
                            <div class="w-12 h-12 rounded-full bg-white flex items-center justify-center text-red-800 font-bold mr-4 shadow-lg">
                                2
                            </div>
                            <h3 class="text-xl font-bold text-white">
                                Búsqueda Internacional
                            </h3>
                        </div>
                        <svg class="w-6 h-6 text-white transform transition-transform duration-200" :class="{ 'rotate-180': open }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </button>
                    <div x-show="open" x-collapse class="px-6 pb-6 pt-2 bg-white">
                        <p class="text-gray-600 mb-4">Nuestros expertos rastrean el mercado europeo buscando las mejores oportunidades.</p>
                        <ul class="space-y-3 text-gray-600">
                            <li class="flex items-start">
                                <svg class="w-5 h-5 text-red-700 mt-0.5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"></path>
                                </svg>
                                <span>Acceso a subastas profesionales y mercados B2B exclusivos</span>
                            </li>
                            <li class="flex items-start">
                                <svg class="w-5 h-5 text-red-700 mt-0.5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
