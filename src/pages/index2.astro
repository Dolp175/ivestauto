---
// src/pages/index.astro
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="IVESTAUTO - Especialistas en venta de accesorios y recambios para vehículos 4x4. Compra-venta de vehículos de ocasión y camiones. Calidad y experiencia garantizada.">
    <meta name="keywords" content="4x4, accesorios 4x4, recambios, vehículos ocasión, camiones, todoterreno, repuestos, automóvil">
    <meta name="author" content="IVESTAUTO">
    <meta name="robots" content="index, follow">
    
    <!-- Open Graph -->
    <meta property="og:title" content="IVESTAUTO - Especialistas en 4x4 y Vehículos de Ocasión">
    <meta property="og:description" content="Tu especialista de confianza en accesorios, recambios 4x4 y venta de vehículos de ocasión. Calidad garantizada.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://ivestauto.com">
    <meta property="og:image" content="/og-image.jpg">
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="IVESTAUTO - Especialistas en 4x4">
    <meta name="twitter:description" content="Accesorios, recambios 4x4 y vehículos de ocasión">
    
    <title>IVESTAUTO - Especialistas en 4x4 y Vehículos de Ocasión</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" href="/favicon.png">
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body class="font-sans antialiased bg-white">
    <!-- Header -->
    <header class="bg-white shadow-lg sticky top-0 z-50">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Logo -->
                <div class="flex-shrink-0">
                    <div class="flex items-center space-x-3">
                        <img src="/logo.png" alt="IVESTAUTO Logo" class="h-8 w-auto">
                        <h1 class="text-2xl font-bold">
                            <span class="text-black">IVEST</span><span class="text-red-700">AUTO</span>
                        </h1>
                    </div>
                </div>
                
                <!-- Navigation Desktop -->
                <div class="hidden md:block">
                    <div class="ml-10 flex items-baseline space-x-8">
                        <a href="#inicio" class="text-gray-900 hover:text-red-700 px-3 py-2 text-sm font-medium transition-colors">Inicio</a>
                        <a href="#servicios" class="text-gray-900 hover:text-red-700 px-3 py-2 text-sm font-medium transition-colors">Servicios</a>
                        <a href="#productos" class="text-gray-900 hover:text-red-700 px-3 py-2 text-sm font-medium transition-colors">Productos</a>
                        <a href="#vehiculos" class="text-gray-900 hover:text-red-700 px-3 py-2 text-sm font-medium transition-colors">Vehículos</a>
                        <a href="#contacto" class="bg-red-700 text-white hover:bg-red-800 px-4 py-2 rounded-md text-sm font-medium transition-colors">Contacto</a>
                    </div>
                </div>
                
                <!-- Mobile menu button -->
                <div class="md:hidden">
                    <button type="button" class="mobile-menu-button inline-flex items-center justify-center p-2 rounded-md text-gray-900 hover:text-red-700 focus:outline-none">
                        <span class="sr-only">Abrir menú principal</span>
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>
                </div>
            </div>
            
            <!-- Mobile Navigation -->
            <div class="mobile-menu hidden md:hidden">
                <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3 bg-white border-t">
                    <a href="#inicio" class="text-gray-900 hover:text-red-700 block px-3 py-2 text-base font-medium">Inicio</a>
                    <a href="#servicios" class="text-gray-900 hover:text-red-700 block px-3 py-2 text-base font-medium">Servicios</a>
                    <a href="#productos" class="text-gray-900 hover:text-red-700 block px-3 py-2 text-base font-medium">Productos</a>
                    <a href="#vehiculos" class="text-gray-900 hover:text-red-700 block px-3 py-2 text-base font-medium">Vehículos</a>
                    <a href="#contacto" class="text-gray-900 hover:text-red-700 block px-3 py-2 text-base font-medium">Contacto</a>
                </div>
            </div>
        </nav>
    </header>

    <!-- Hero Section -->
    <section id="inicio" class="relative bg-gradient-to-b from-slate-800 to-slate-900 text-white">
        <div class="absolute inset-0 bg-black opacity-50"></div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
            <div class="text-center">
                <h2 class="text-4xl md:text-6xl font-bold mb-6">
                    Tu especialista en <span class="text-red-700">4x4</span>
                </h2>
                <p class="text-xl md:text-2xl text-gray-300 mb-8 max-w-3xl mx-auto">
                    Accesorios, recambios y vehículos de ocasión. Más de 10 años de experiencia en el sector automotriz.
                </p>
                <div class="space-y-4 sm:space-y-0 sm:space-x-4 sm:flex sm:justify-center">
                    <a href="#servicios" class="inline-block bg-red-700 text-white px-8 py-3 rounded-lg text-lg font-semibold hover:bg-red-800 transition-colors">
                        Nuestros Servicios
                    </a>
                    <a href="#contacto" class="inline-block border-2 border-white text-white px-8 py-3 rounded-lg text-lg font-semibold hover:bg-white hover:text-gray-900 transition-colors">
                        Contactar Ahora
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Servicios -->
    <section id="servicios" class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                    Nuestros Servicios
                </h2>
                <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                    Ofrecemos soluciones completas para todas tus necesidades.
                </p>
            </div>
            
            <div class="grid md:grid-cols-3 gap-8">
                <!-- Servicio 1 -->
                <div class="bg-white rounded-lg shadow-lg p-8 text-center hover:shadow-xl transition-shadow">
                    <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-6">
                        <svg class="w-8 h-8 text-red-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.781 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 7.172V5L8 4z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-4">Accesorios 4x4</h3>
                    <p class="text-gray-600">Amplia gama de accesorios para equipar tu vehículo 4x4 con los mejores complementos del mercado.</p>
                </div>
                
                <!-- Servicio 2 -->
                <div class="bg-white rounded-lg shadow-lg p-8 text-center hover:shadow-xl transition-shadow">
                    <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-6">
                        <svg class="w-8 h-8 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-4">Recambios</h3>
                    <p class="text-gray-600">Repuestos originales y compatibles para mantener tu vehículo en perfectas condiciones de funcionamiento.</p>
                </div>
                
                <!-- Servicio 3 -->
                <div class="bg-white rounded-lg shadow-lg p-8 text-center hover:shadow-xl transition-shadow">
                    <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
                        <svg class="w-8 h-8 text-green-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-4">Compra-Venta</h3>
                    <p class="text-gray-600">Coches de ocasión y camiones revisados y garantizados. Facilitamos tu cambio de vehículo.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Productos Destacados -->
    <section id="productos" class="py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                    Productos Destacados
                </h2>
                <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                    Selección de nuestros productos más populares
                </p>
            </div>
            
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
                <!-- Producto 1 -->
                <div class="bg-gray-50 rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
                    <div class="h-48 overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1544636331-e26879cd4d9b?w=400&h=300&fit=crop&crop=center" 
                             alt="Barras de Techo para 4x4" 
                             class="w-full h-full object-cover hover:scale-105 transition-transform duration-300">
                    </div>
                    <div class="p-6">
                        <h3 class="font-bold text-gray-900 mb-2">Barras de Techo</h3>
                        <p class="text-gray-600 text-sm">Resistentes y aerodinámicas</p>
                    </div>
                </div>
                
                <!-- Producto 2 -->
                <div class="bg-gray-50 rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
                    <div class="h-48 overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=400&h=300&fit=crop&crop=center" 
                             alt="Neumáticos 4x4 todoterreno" 
                             class="w-full h-full object-cover hover:scale-105 transition-transform duration-300">
                    </div>
                    <div class="p-6">
                        <h3 class="font-bold text-gray-900 mb-2">Neumáticos 4x4</h3>
                        <p class="text-gray-600 text-sm">Para todo tipo de terrenos</p>
                    </div>
                </div>
                
                <!-- Producto 3 -->
                <div class="bg-gray-50 rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
                    <div class="h-48 overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1544636331-e26879cd4d9b?w=400&h=300&fit=crop&crop=center" 
                             alt="Cabrestante winch para SUV 4x4" 
                             class="w-full h-full object-cover hover:scale-105 transition-transform duration-300">
                    </div>
                    <div class="p-6">
                        <h3 class="font-bold text-gray-900 mb-2">Cabrestantes</h3>
                        <p class="text-gray-600 text-sm">Potentes y confiables</p>
                    </div>
                </div>
                
                <!-- Producto 4 -->
                <div class="bg-gray-50 rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
                    <div class="h-48 overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1502489597346-dad15683d4c2?w=400&h=300&fit=crop&crop=center" 
                             alt="Protecciones y blindajes para vehículos" 
                             class="w-full h-full object-cover hover:scale-105 transition-transform duration-300">
                    </div>
                    <div class="p-6">
                        <h3 class="font-bold text-gray-900 mb-2">Protecciones</h3>
                        <p class="text-gray-600 text-sm">Blindajes y cubrecárteres</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Llamada a la Acción Compacta -->
    <section class="py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-center">
            <div class="bg-slate-800 rounded-full px-8 py-4 shadow-lg">
                <div class="flex items-center space-x-6">
                    <p class="text-white font-semibold">
                        ¿Necesitas asesoramiento sobre accesorios 4x4? Te ayudamos a encontrar lo que buscas
                    </p>
                    <a href="tel:+34123456789" 
                       class="inline-flex items-center bg-red-700 text-white px-6 py-3 rounded-full font-bold hover:bg-red-800 transition-colors shadow-md whitespace-nowrap">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                        </svg>
                        Llama Ya
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Vehículos -->
    <section id="vehiculos" class="py-16 bg-gradient-to-r from-red-100 to-blue-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                    Vehículos de Ocasión
                </h2>
                <p class="text-xl text-gray-700 max-w-2xl mx-auto">
                    Vehículos 4x4 y camiones revisados con garantía
                </p>
            </div>
            
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Vehículo 1 -->
                <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                    <div class="h-48 bg-gradient-to-br from-gray-300 to-gray-400 flex items-center justify-center">
                        <span class="text-gray-600 font-medium">Toyota Land Cruiser</span>
                    </div>
                    <div class="p-6">
                        <h3 class="font-bold text-xl mb-2 text-gray-900">Toyota Land Cruiser 3.0 D-4D</h3>
                        <div class="text-gray-600 mb-4 space-y-1">
                            <p class="text-sm">• 2018 • Diésel • Manual</p>
                            <p class="text-sm">• 145.000 km • ITV al día</p>
                            <p class="text-sm">• Revisiones en concesionario</p>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-red-700 font-bold text-2xl">24.999€</span>
                            <a href="#contacto" class="bg-red-700 text-white px-4 py-2 rounded hover:bg-red-800 transition-colors">Contactar</a>
                        </div>
                    </div>
                </div>
                
                <!-- Vehículo 2 -->
                <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                    <div class="h-48 bg-gradient-to-br from-blue-300 to-blue-400 flex items-center justify-center">
                        <span class="text-blue-800 font-medium">Iveco Daily</span>
                    </div>
                    <div class="p-6">
                        <h3 class="font-bold text-xl mb-2 text-gray-900">Iveco Daily 35S15 Camión</h3>
                        <div class="text-gray-600 mb-4 space-y-1">
                            <p class="text-sm">• 2020 • Diésel • Manual</p>
                            <p class="text-sm">• 89.500 km • Caja basculante</p>
                            <p class="text-sm">• Perfecto estado • Un solo propietario</p>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-red-700 font-bold text-2xl">32.500€</span>
                            <a href="#contacto" class="bg-red-700 text-white px-4 py-2 rounded hover:bg-red-800 transition-colors">Contactar</a>
                        </div>
                    </div>
                </div>
                
                <!-- Vehículo 3 -->
                <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                    <div class="h-48 bg-gradient-to-br from-green-300 to-green-400 flex items-center justify-center">
                        <span class="text-green-800 font-medium">Jeep Wrangler</span>
                    </div>
                    <div class="p-6">
                        <h3 class="font-bold text-xl mb-2 text-gray-900">Jeep Wrangler 2.8 CRD Sahara</h3>
                        <div class="text-gray-600 mb-4 space-y-1">
                            <p class="text-sm">• 2017 • Diésel • Automático</p>
                            <p class="text-sm">• 98.000 km • Capota rígida</p>
                            <p class="text-sm">• Extras: Winch, barras LED</p>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-red-700 font-bold text-2xl">28.999€</span>
                            <a href="#contacto" class="bg-red-700 text-white px-4 py-2 rounded hover:bg-red-800 transition-colors">Contactar</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contacto -->
    <section id="contacto" class="py-16 bg-gray-900 text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-4xl font-bold mb-4">
                    Contacta con Nosotros
                </h2>
                <p class="text-xl text-gray-300 max-w-2xl mx-auto">
                    Estamos aquí para ayudarte con todas tus necesidades automotrices
                </p>
            </div>
            
            <div class="grid md:grid-cols-2 gap-12">
                <!-- Información de contacto -->
                <div>
                    <h3 class="text-2xl font-bold mb-6 text-red-400">Información de Contacto</h3>
                    <div class="space-y-4">
                        <div class="flex items-center">
                            <svg class="w-6 h-6 text-red-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                            </svg>
                            <span>+34 XXX XXX XXX</span>
                        </div>
                        <div class="flex items-center">
                            <svg class="w-6 h-6 text-red-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                            </svg>
                            <span>info@ivestauto.com</span>
                        </div>
                        <div class="flex items-center">
                            <svg class="w-6 h-6 text-red-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            <span>Dirección de la empresa<br>Ciudad, Código Postal</span>
                        </div>
                        <div class="flex items-center">
                            <svg class="w-6 h-6 text-red-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <span>Lun - Vie: 9:00 - 18:00<br>Sáb: 9:00 - 14:00</span>
                        </div>
                    </div>
                </div>
                
                <!-- Formulario de contacto -->
                <div>
                    <h3 class="text-2xl font-bold mb-6 text-red-400">Envíanos un Mensaje</h3>
                    <form class="space-y-4">
                        <div>
                            <label for="nombre" class="block text-sm font-medium mb-2">Nombre</label>
                            <input type="text" id="nombre" name="nombre" class="w-full px-4 py-2 bg-gray-800 border border-gray-700 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent text-white" required>
                        </div>
                        <div>
                            <label for="email" class="block text-sm font-medium mb-2">Email</label>
                            <input type="email" id="email" name="email" class="w-full px-4 py-2 bg-gray-800 border border-gray-700 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent text-white" required>
                        </div>
                        <div>
                            <label for="telefono" class="block text-sm font-medium mb-2">Teléfono</label>
                            <input type="tel" id="telefono" name="telefono" class="w-full px-4 py-2 bg-gray-800 border border-gray-700 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent text-white">
                        </div>
                        <div>
                            <label for="mensaje" class="block text-sm font-medium mb-2">Mensaje</label>
                            <textarea id="mensaje" name="mensaje" rows="4" class="w-full px-4 py-2 bg-gray-800 border border-gray-700 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent text-white" required></textarea>
                        </div>
                        <button type="submit" class="w-full bg-red-700 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-800 transition-colors">
                            Enviar Mensaje
                        </button>
                    </form>
                </div>
            </div>
        </div>
