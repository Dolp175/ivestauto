---
// src/components/layout/Footer.astro
---

<footer class="bg-gray-50 dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 transition-colors duration-300">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Sección principal del footer -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 py-12">
      
      <!-- Logo y descripción -->
      <div class="col-span-1 lg:col-span-2">
        <div class="flex items-center space-x-3 mb-4">
          <img 
            src="/logo.png" 
            alt="IVESTAUTO - Repuestos 4x4 y Vehículos de Importación" 
            class="h-10 w-auto"
            width="50"
            height="50"
            loading="lazy"
          />
          <h2 class="text-2xl font-bold">
            <span class="text-gray-900 dark:text-white">IVEST</span>
            <span class="text-red-600 dark:text-red-500">AUTO</span>
          </h2>
        </div>
        <p class="text-gray-600 dark:text-gray-400 max-w-md text-lg leading-relaxed">
          Especialistas en repuestos y accesorios para coches 4x4. Venta de vehículos 
          de ocasión de importación por encargo. Calidad, garantía y servicio personalizado.
        </p>
        
        <!-- Redes sociales -->
        <div class="flex space-x-4 mt-6">
          <a 
            href="https://www.facebook.com/ivestauto" 
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 text-gray-500 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400 transition-colors rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700"
            aria-label="Síguenos en Facebook"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a 
            href="https://www.instagram.com/ivestauto" 
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 text-gray-500 hover:text-pink-600 dark:text-gray-400 dark:hover:text-pink-400 transition-colors rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700"
            aria-label="Síguenos en Instagram"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.017 0C8.396 0 7.987 0.021 6.761 0.106 5.536 0.191 4.677 0.437 3.914 0.81 3.151 1.184 2.507 1.672 1.864 2.315 1.221 2.958 0.733 3.602 0.36 4.365 -0.013 5.128 -0.259 5.987 -0.344 7.212 -0.429 8.438 -0.45 8.847 -0.45 12.468c0 3.621 0.021 4.03 0.106 5.256 0.085 1.225 0.331 2.084 0.704 2.847 0.373 0.763 0.861 1.407 1.504 2.05 0.643 0.643 1.287 1.131 2.05 1.504 0.763 0.373 1.622 0.619 2.847 0.704 1.225 0.085 1.634 0.106 5.256 0.106 3.621 0 4.03 -0.021 5.256 -0.106 1.225 -0.085 2.084 -0.331 2.847 -0.704 0.763 -0.373 1.407 -0.861 2.05 -1.504 0.643 -0.643 1.131 -1.287 1.504 -2.05 0.373 -0.763 0.619 -1.622 0.704 -2.847 0.085 -1.225 0.106 -1.634 0.106 -5.256 0 -3.621 -0.021 -4.03 -0.106 -5.256 -0.085 -1.225 -0.331 -2.084 -0.704 -2.847 -0.373 -0.763 -0.861 -1.407 -1.504 -2.05 -0.643 -0.643 -1.287 -1.131 -2.05 -1.504 -0.763 -0.373 -1.622 -0.619 -2.847 -0.704C16.047 0.021 15.638 0 12.017 0zM12.017 1.942c3.554 0 3.938 0.019 5.147 0.102 1.138 0.08 1.754 0.319 2.165 0.529 0.537 0.275 0.919 0.603 1.322 1.006 0.403 0.403 0.731 0.785 1.006 1.322 0.21 0.411 0.449 1.027 0.529 2.165 0.083 1.209 0.102 1.593 0.102 5.147 0 3.554 -0.019 3.938 -0.102 5.147 -0.08 1.138 -0.319 1.754 -0.529 2.165 -0.275 0.537 -0.603 0.919 -1.006 1.322 -0.403 0.403 -0.785 0.731 -1.322 1.006 -0.411 0.21 -1.027 0.449 -2.165 0.529 -1.209 0.083 -1.593 0.102 -5.147 0.102 -3.554 0 -3.938 -0.019 -5.147 -0.102 -1.138 -0.08 -1.754 -0.319 -2.165 -0.529 -0.537 -0.275 -0.919 -0.603 -1.322 -1.006 -0.403 -0.403 -0.731 -0.785 -1.006 -1.322 -0.21 -0.411 -0.449 -1.027 -0.529 -2.165 -0.083 -1.209 -0.102 -1.593 -0.102 -5.147 0 -3.554 0.019 -3.938 0.102 -5.147 0.08 -1.138 0.319 -1.754 0.529 -2.165 0.275 -0.537 0.603 -0.919 1.006 -1.322 0.403 -0.403 0.785 -0.731 1.322 -1.006 0.411 -0.21 1.027 -0.449 2.165 -0.529 1.209 -0.083 1.593 -0.102 5.147 -0.102z"/>
              <path d="M12.017 5.841c-3.403 0 -6.162 2.759 -6.162 6.162s2.759 6.162 6.162 6.162 6.162 -2.759 6.162 -6.162 -2.759 -6.162 -6.162 -6.162zM12.017 15.453c-1.907 0 -3.45 -1.543 -3.45 -3.45s1.543 -3.45 3.45 -3.45 3.45 1.543 3.45 3.45 -1.543 3.45 -3.45 3.45z"/>
              <circle cx="18.406" cy="5.595" r="1.439"/>
            </svg>
          </a>
          <a 
            href="https://www.linkedin.com/company/ivestauto" 
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 text-gray-500 hover:text-blue-700 dark:text-gray-400 dark:hover:text-blue-500 transition-colors rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700"
            aria-label="Síguenos en LinkedIn"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Enlaces rápidos -->
      <div>
        <h3 class="font-semibold text-gray-900 dark:text-white mb-4 text-lg">Enlaces Rápidos</h3>
        <ul class="space-y-3">
          <li>
            <a 
              href="/" 
              class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors block py-1"
            >
              Inicio
            </a>
          </li>
          <li>
            <a 
              href="/servicios" 
              class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors block py-1"
            >
              Servicios
            </a>
          </li>
          <li>
            <a 
              href="/productos" 
              class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors block py-1"
            >
              Productos
            </a>
          </li>
          <li>
            <a 
              href="/ocasion" 
              class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors block py-1"
            >
              Vehículos Ocasión
            </a>
          </li>
          <li>
            <a 
              href="/contacto" 
              class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors block py-1"
            >
              Contacto
            </a>
          </li>
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h3 class="font-semibold text-gray-900 dark:text-white mb-4 text-lg">Contacto</h3>
        <ul class="space-y-3 text-gray-600 dark:text-gray-400">
          <li class="flex items-start space-x-3">
            <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>Calle Ejemplo, 123<br>28001 Madrid, España</span>
          </li>
          <li class="flex items-center space-x-3">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a 
              href="tel:+34910000000" 
              class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >
              +34 910 000 000
            </a>
          </li>
          <li class="flex items-center space-x-3">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a 
              href="mailto:info@ivestauto.com" 
              class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >
              info@ivestauto.com
            </a>
          </li>
          <li class="flex items-center space-x-3">
            <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893c0-3.176-1.24-6.165-3.495-8.411"/>
            </svg>
            <a 
              href="https://wa.me/34910000000" 
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-green-600 dark:hover:text-green-400 transition-colors"
            >
              WhatsApp
            </a>
          </li>
        </ul>

        <!-- Horario -->
        <div class="mt-6 p-4 bg-white dark:bg-gray-700 rounded-lg border border-gray-200 dark:border-gray-600">
          <h4 class="font-semibold text-gray-900 dark:text-white mb-2 text-sm">Horario</h4>
          <div class="text-sm text-gray-600 dark:text-gray-400 space-y-1">
            <div class="flex justify-between">
              <span>Lun - Vie:</span>
              <span>9:00 - 18:00</span>
            </div>
            <div class="flex justify-between">
              <span>Sábados:</span>
              <span>10:00 - 14:00</span>
            </div>
            <div class="flex justify-between">
              <span>Domingos:</span>
              <span>Cerrado</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Copyright y enlaces legales -->
    <div class="border-t border-gray-200 dark:border-gray-700 py-6">
      <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
        <div class="text-gray-500 dark:text-gray-400 text-sm">
          &copy; {new Date().getFullYear()} IVESTAUTO. Todos los derechos reservados.
        </div>
        <div class="flex space-x-6 text-sm">
          <a 
            href="/aviso-legal" 
            class="text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
          >
            Aviso Legal
          </a>
          <a 
            href="/politica-privacidad" 
            class="text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
          >
            Política de Privacidad
          </a>
          <a 
            href="/cookies" 
            class="text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
          >
            Cookies
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>