---
// src/components/layout/Navigation.astro

const navItems = [
  { href: "#servicios", label: "Servicios" },
  { href: "#productos", label: "Productos" },
  { href: "#vehiculos", label: "Vehículos" },
  { href: "#contacto", label: "Contacto" },
];
---

<nav aria-label="Navegación principal">
  <ul class="flex space-x-6 2xl:space-x-10">
    {navItems.map((item) => (
      <li>
        <a
          href={item.href}
          class="px-3.5 py-2.5 text-base 2xl:text-lg font-semibold text-gray-900 hover:text-rose-700 transition-colors focus:outline-none focus:ring-2 focus:ring-rose-500 focus:ring-offset-2 rounded-md whitespace-nowrap tracking-wide"
          aria-current={Astro.url.pathname === item.href ? 'page' : undefined}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
