---
// src/components/layout/Navigation.astro

const navItems = [
  { href: "/servicios", label: "Servicios" },
  { href: "/productos", label: "Productos" },
  { href: "/vehiculos", label: "Vehículos" },
  { href: "/contacto", label: "Contacto" },
];
---

<nav aria-label="Navegación principal">
  <ul class="flex space-x-4 lg:space-x-8">
    {navItems.map((item) => (
      <li>
        <a 
          href={item.href}
          class="text-gray-900 hover:text-red-700 px-2 lg:px-3 py-2 text-sm font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 rounded-md whitespace-nowrap"
          aria-current={Astro.url.pathname === item.href ? 'page' : undefined}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>