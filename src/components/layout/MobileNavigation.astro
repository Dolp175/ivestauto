---
// src/components/layout/MobileNavigation.astro
import { useState } from 'preact/hooks';

const navItems = [
  { href: "#servicios", label: "Servicios" },
  { href: "#productos", label: "Productos" },
  { href: "#vehiculos", label: "Vehículos" },
  { href: "#contacto", label: "Contacto" },
];
---

<div class="relative">
  <!-- Botón hamburguesa -->
  <button
    id="mobile-menu-button"
    class="mobile-menu-button inline-flex items-center justify-center p-2 rounded-md text-gray-900 hover:text-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2"
    aria-label="Abrir menú de navegación"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>

  <!-- Menú móvil -->
  <div
    id="mobile-menu"
    class="mobile-menu absolute right-0 top-full mt-2 w-56 bg-white rounded-lg shadow-lg ring-1 ring-black ring-opacity-5 hidden"
  >
    <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3 bg-white border-t rounded-lg">
      {navItems.map((item) => (
        <a 
          href={item.href}
          class="text-gray-900 hover:text-red-700 block px-3 py-2 text-base font-medium rounded-md hover:bg-gray-50 transition-colors"
          aria-current={Astro.url.pathname === item.href ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      
      <!-- Contacto móvil - SOLO AQUÍ EL NÚMERO COMPLETO -->
      <div class="border-t border-gray-200 pt-2 mt-2">
        <a 
          href="tel:+34682290381"
          class="flex items-center space-x-2 px-3 py-2 text-base font-bold text-gray-900 hover:text-red-700 rounded-md hover:bg-gray-50 transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>682 290 381</span> <!-- Sin +34 -->
        </a>
      </div>
      
      <a 
        href="https://wa.me/34682290381"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center space-x-2 px-3 py-2 text-base font-medium text-gray-900 hover:text-green-600 rounded-md hover:bg-gray-50 transition-colors"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893c0-3.176-1.24-6.165-3.495-8.411"/>
        </svg>
        <span>WhatsApp</span>
      </a>

      <!-- Botón Contacto en móvil -->
      <a 
        href="#contacto"
        class="flex items-center justify-center bg-red-700 text-white hover:bg-red-800 px-3 py-2 text-base font-medium rounded-md transition-colors mx-2"
      >
        Contacto
      </a>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    const mobileMenuButton = document.querySelector('.mobile-menu-button');
    const mobileMenu = document.querySelector('.mobile-menu');

    mobileMenuButton.addEventListener('click', function() {
      const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';
      mobileMenuButton.setAttribute('aria-expanded', !isExpanded);
      mobileMenu.classList.toggle('hidden');
    });

    // Cerrar menú al hacer clic fuera
    document.addEventListener('click', function(e) {
      if (!mobileMenuButton.contains(e.target) && !mobileMenu.contains(e.target)) {
        mobileMenuButton.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.add('hidden');
      }
    });
  });
</script>