---
// src/components/ContactForm.astro
export interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "¿Tienes alguna duda?",
  subtitle = "Contáctanos y te responderemos en menos de 24 horas" 
} = Astro.props;
---

<div class="w-full max-w-4xl mx-auto">
  <!-- Encabezado -->
  <div class="text-center mb-12">
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{title}</h2>
    <p class="text-xl text-gray-300 max-w-2xl mx-auto">{subtitle}</p>
  </div>

  <!-- Formulario -->
  <form 
    action="https://formsubmit.co/tu-email@gmail.com" 
    method="POST"
    class="bg-white rounded-2xl shadow-xl p-6 md:p-8 border border-gray-200"
  >
    <!-- Campos ocultos de FormSubmit -->
    <input type="hidden" name="_subject" value="Nuevo mensaje desde la web - 4x4Specialist">
    <input type="hidden" name="_template" value="table">
    <input type="hidden" name="_captcha" value="false">
    <input type="hidden" name="_next" value="https://tudominio.com/gracias">
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      <!-- Nombre -->
      <div>
        <label for="nombre" class="block text-sm font-medium text-gray-700 mb-2">
          Nombre completo *
        </label>
        <input
          type="text"
          id="nombre"
          name="nombre"
          required
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 text-gray-900"
          placeholder="Tu nombre"
        />
      </div>

      <!-- Teléfono -->
      <div>
        <label for="telefono" class="block text-sm font-medium text-gray-700 mb-2">
          Teléfono
        </label>
        <input
          type="tel"
          id="telefono"
          name="telefono"
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 text-gray-900"
          placeholder="+34 123 456 789"
        />
      </div>
    </div>

    <!-- Email -->
    <div class="mb-6">
      <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
        Email *
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 text-gray-900"
        placeholder="tu@email.com"
      />
    </div>

    <!-- Asunto -->
    <div class="mb-6">
      <label for="asunto" class="block text-sm font-medium text-gray-700 mb-2">
        Asunto *
      </label>
      <select
        id="asunto"
        name="asunto"
        required
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 text-gray-900"
      >
        <option value="" disabled selected>Selecciona el motivo de tu consulta</option>
        <option value="recambios">Consulta sobre recambios</option>
        <option value="accesorios">Información sobre accesorios 4x4</option>
        <option value="vehiculos">Importación de vehículos</option>
        <option value="presupuesto">Solicitud de presupuesto</option>
        <option value="otro">Otro asunto</option>
      </select>
    </div>

    <!-- Mensaje -->
    <div class="mb-6">
      <label for="mensaje" class="block text-sm font-medium text-gray-700 mb-2">
        Mensaje *
      </label>
      <textarea
        id="mensaje"
        name="mensaje"
        rows="5"
        required
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 resize-vertical text-gray-900"
        placeholder="Describe tu consulta o necesidad..."
      ></textarea>
    </div>

    <!-- Checkbox Newsletter -->
    <div class="mb-6">
      <label class="flex items-start">
        <input
          type="checkbox"
          name="newsletter"
          class="mt-1 mr-3 rounded border-gray-300 text-red-600 focus:ring-red-500"
        />
        <span class="text-sm text-gray-600">
          Deseo recibir información sobre novedades, ofertas especiales y consejos para mi 4x4
        </span>
      </label>
    </div>

    <!-- Botón de envío -->
    <div class="text-center">
      <button
        type="submit"
        class="bg-red-700 text-white px-8 py-4 rounded-lg font-bold hover:bg-red-800 transition-colors duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-transform w-full md:w-auto"
      >
        <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        Enviar Mensaje
      </button>
    </div>

    <!-- Aviso legal -->
    <p class="text-xs text-gray-500 text-center mt-6">
      Al enviar este formulario aceptas nuestra 
      <a href="/politica-privacidad" class="text-red-600 hover:text-red-700 underline">política de privacidad</a>. 
      Tus datos serán tratados de forma confidencial.
    </p>
  </form>
</div>